export component WifiPasswordView inherits Rectangle {
    in property <string> network-name: "";
    in property <string> keyboard-text: "";
    in property <string> status-text: "";
    in property <string> visibility-label: "SHOW";
    in property <int> selected-action: 0;
    in property <bool> focused: false;
    callback append_selected();
    callback backspace();
    callback clear_password();
    callback toggle_visibility();
    callback connect();
    callback cancel();

    background: #0b0c10;

    Text {
        y: 72px;
        width: parent.width;
        text: "Wi-Fi Password";
        color: #f4f7f5;
        font-size: 42px;
        font-weight: 800;
        horizontal-alignment: center;
    }

    Rectangle {
        x: parent.width / 2 - 780px;
        y: 150px;
        width: 1560px;
        height: 610px;
        background: #15181d;
        border-radius: 6px;

        Text { x: 32px; y: 24px; text: root.network-name != "" ? root.network-name : "ENTER PASSWORD"; color: #1db954; font-size: 13px; font-weight: 800; }
        Rectangle { x: 24px; y: 58px; width: parent.width - 48px; height: 1px; background: #2a3030; }

        Rectangle {
            x: 24px;
            y: 82px;
            width: parent.width - 48px;
            height: 386px;
            background: root.focused && root.selected-action == 0 ? #1b2027 : #11151b;
            border-width: 1px;
            border-color: root.focused && root.selected-action == 0 ? #1db954 : #2a3030;
            border-radius: 4px;

            Text {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                height: 362px;
                text: root.keyboard-text;
                color: #eef2ef;
                font-size: 17px;
                font-family: "monospace";
            }

            TouchArea { clicked => { root.append_selected(); } }
        }

        Rectangle {
            x: 24px;
            y: 490px;
            width: 284px;
            height: 48px;
            background: root.focused && root.selected-action == 1 ? #1f513f : #11151b;
            border-width: 1px;
            border-color: #1db954;
            border-radius: 4px;
            Text { x: 0px; y: 9px; width: 284px; text: "BACKSPACE"; color: #eef2ef; font-size: 18px; horizontal-alignment: center; }
            TouchArea { clicked => { root.backspace(); } }
        }

        Rectangle {
            x: 328px;
            y: 490px;
            width: 284px;
            height: 48px;
            background: root.focused && root.selected-action == 2 ? #1f513f : #11151b;
            border-width: 1px;
            border-color: #1db954;
            border-radius: 4px;
            Text { x: 0px; y: 9px; width: 284px; text: "CLEAR"; color: #eef2ef; font-size: 18px; horizontal-alignment: center; }
            TouchArea { clicked => { root.clear_password(); } }
        }

        Rectangle {
            x: 632px;
            y: 490px;
            width: 284px;
            height: 48px;
            background: root.focused && root.selected-action == 3 ? #1f513f : #11151b;
            border-width: 1px;
            border-color: #1db954;
            border-radius: 4px;
            Text { x: 0px; y: 9px; width: 284px; text: root.visibility-label; color: #eef2ef; font-size: 18px; horizontal-alignment: center; }
            TouchArea { clicked => { root.toggle_visibility(); } }
        }

        Rectangle {
            x: 936px;
            y: 490px;
            width: 284px;
            height: 48px;
            background: root.focused && root.selected-action == 4 ? #1f513f : #11151b;
            border-width: 1px;
            border-color: #1db954;
            border-radius: 4px;
            Text { x: 0px; y: 9px; width: 284px; text: "CONNECT & SAVE"; color: #eef2ef; font-size: 18px; horizontal-alignment: center; }
            TouchArea { clicked => { root.connect(); } }
        }

        Rectangle {
            x: 1240px;
            y: 490px;
            width: 284px;
            height: 48px;
            background: root.focused && root.selected-action == 5 ? #1f513f : #11151b;
            border-width: 1px;
            border-color: #3a4046;
            border-radius: 4px;
            Text { x: 0px; y: 9px; width: 284px; text: "CANCEL"; color: #eef2ef; font-size: 18px; horizontal-alignment: center; }
            TouchArea { clicked => { root.cancel(); } }
        }
    }

    Text {
        y: 800px;
        width: parent.width;
        text: root.status-text;
        color: #ffb870;
        font-size: 13px;
        horizontal-alignment: center;
    }
}